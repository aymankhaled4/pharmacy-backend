# Application
NODE_ENV=development
PORT=3000

# Supabase — project URL and keys from Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_WEBHOOK_SECRET=your-webhook-secret

# OpenAI — used by AI chat and Excel import (Task 5)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Redis — used for role/drug search caching (Task 1/3)
REDIS_URL=redis://localhost:6379

# Firebase — FCM push notifications (Task 4); JSON service account as single-line string
FIREBASE_SERVICE_ACCOUNT=

# CORS — comma-separated allowed origins (e.g. http://localhost:3000,http://localhost:5173)
CORS_ORIGINS=http://localhost:3000
