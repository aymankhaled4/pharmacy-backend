              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pharmacy_name\": \"El Nour Pharmacy - Updated\",\n  \"phone\": \"+201098765432\",\n  \"address\": \"20 Ramses Street\",\n  \"city\": \"Cairo\"\n}"
            },
            "url": "{{base_url}}/pharmacy/me"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Requires `admin_token` — create admin in Supabase Dashboard, then Auth → Login → Login Admin.",
      "item": [
        {
          "name": "List Pharmacies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/pharmacies?status=pending",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "pharmacies"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          }
        },
        {
          "name": "Approve Pharmacy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/admin/pharmacies/{{pharmacy_id}}/approve"
          }
        },
        {
          "name": "Reject Pharmacy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejection_reason\": \"License document is expired or invalid\"\n}"
            },
            "url": "{{base_url}}/admin/pharmacies/{{pharmacy_id}}/reject"
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/users?limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "include_deleted",
                  "value": "false",
                  "disabled": true
                },
                {
                  "key": "cursor",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Soft Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
