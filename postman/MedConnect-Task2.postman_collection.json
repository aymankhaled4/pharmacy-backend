              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/analytics/drugs/purchased?limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "analytics",
                "drugs",
                "purchased"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}