            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": "{{base_url}}/users/me"
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Ahmed Mohamed Updated\",\n  \"phone\": \"+201098765432\"\n}"
            },
            "url": "{{base_url}}/users/me"
          }
        },
        {
          "name": "Register FCM Token",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcm_token\": \"fME9v2-example-device-token\"\n}"
            },
            "url": "{{base_url}}/users/me/fcm-token"
          }
        }
      ]
    },
    {
      "name": "Pharmacy",
      "description": "Requires `pharmacy_token` — run Auth → Registration or Login first.",
      "item": [
        {
          "name": "Get My Pharmacy Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacy_token}}"
              }
